{
  "name": "hd-editor",
  "displayName": "HD Editor",
  "description": "WYSIWYG editor for .hd documentation files (body-only HTML with optional YAML frontmatter).",
  "version": "0.1.6",
  "publisher": "sygnal",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCustomEditor:sygnal.hd-editor",
    "onCustomEditor:sygnal.md-editor",
    "onCommand:hd.copyAsMarkdown"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "hd",
        "aliases": [
          "HD",
          "hd"
        ],
        "extensions": [
          ".hd"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/hd.svg",
          "dark": "./icons/hd.svg"
        }
      },
      {
        "id": "hd2",
        "aliases": [
          "HD2",
          "hd2"
        ],
        "extensions": [
          ".hd2"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/hd.svg",
          "dark": "./icons/hd.svg"
        }
      }
    ],
    "customEditors": [
      {
        "viewType": "sygnal.hd-editor",
        "displayName": "HD Editor",
        "selector": [
          {
            "filenamePattern": "*.hd"
          },
          {
            "filenamePattern": "*.hd2"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "sygnal.md-editor",
        "displayName": "Markdown (HD)",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "hd.copyAsMarkdown",
        "title": "HD: Copy as Markdown"
      },
      {
        "command": "hd.regenerateId",
        "title": "HD: Regenerate Document ID"
      },
      {
        "command": "hd.migrateAssetsToFlat",
        "title": "HD: Migrate Workspace Assets to Flat Layout"
      },
      {
        "command": "hd.md.openRaw",
        "title": "HD: Edit Markdown as Raw Text"
      }
    ],
    "configuration": {
      "title": "HD Editor",
      "properties": {
        "hd.markdown.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "Open Markdown (`.md`) files in the HD Markdown editor. Turn this off to use VS Code's built-in text editor for Markdown instead. Applies to newly opened files."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc -p . --noEmit",
    "package": "node scripts/clean-vsix.mjs && npx @vscode/vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/turndown": "^5.0.4",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@lezer/highlight": "^1.2.3",
    "@tiptap/core": "^2.2.0",
    "@tiptap/extension-image": "^2.2.0",
    "@tiptap/extension-link": "^2.2.0",
    "@tiptap/extension-subscript": "^2.2.0",
    "@tiptap/extension-superscript": "^2.2.0",
    "@tiptap/extension-table": "^2.2.0",
    "@tiptap/extension-table-cell": "^2.2.0",
    "@tiptap/extension-table-header": "^2.2.0",
    "@tiptap/extension-table-row": "^2.2.0",
    "@tiptap/extension-task-item": "^2.27.2",
    "@tiptap/extension-task-list": "^2.27.2",
    "@tiptap/extension-underline": "^2.2.0",
    "@tiptap/starter-kit": "^2.2.0",
    "js-yaml": "^4.1.0",
    "marked": "^12.0.0",
    "turndown": "^7.1.0"
  }
}
